# Leave empty when the API is served from the same origin under /api (recommended,
# e.g. behind the bundled nginx or the Vite dev proxy). Otherwise set the API origin,
# e.g. https://api.gotrip.in
VITE_API_BASE_URL=
# Where the Vite dev server proxies /api to.
VITE_DEV_API_PROXY=http://localhost:8000
VITE_SITE_URL=http://localhost:5173
